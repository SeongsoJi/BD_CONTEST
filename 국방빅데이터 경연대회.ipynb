import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Matplotlib 한글 폰트 설정
plt.rcParams['font.sans-serif'] = ['NanumGothic', 'Malgun Gothic', 'DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# =========================================================
# 1. 원천 빅데이터 로드 (순수 검사 점수 데이터)
# =========================================================
raw_csv_path = "신인성검사_원천_빅데이터_1000명.csv"
data = pd.read_csv(raw_csv_path)

# =========================================================
# 2. 시계열 가중치 부여 (1월: 0.2, 2월: 0.3, 3월: 0.5)
# =========================================================
weight_map = {"1월": 0.2, "2월": 0.3, "3월": 0.5}
data["월가중치"] = data["검사회차"].map(weight_map)

# 가중 점수 계산
score_cols = ["임상증상_점수", "대인관계_점수", "위기자살_점수", "부조리피해_점수", "과소응답_점수"]
for col in score_cols:
    data[f"가중_{col}"] = data[col] * data["월가중치"]

# 개인별(군번_ID) 시계열 가중 합산
grouped = data.groupby(["군번_ID", "계급", "소속"]).agg(
    가중_임상증상=("가중_임상증상_점수", "sum"),
    가중_대인관계=("가중_대인관계_점수", "sum"),
    가중_위기자살=("가중_위기자살_점수", "sum"),
    가중_부조리피해=("가중_부조리피해_점수", "sum"),
    가중_과소응답=("가중_과소응답_점수", "sum")
).reset_index()

# 종합 가중 위험도 산출 (4개 임상 영역의 평균)
grouped["종합_가중위험도"] = grouped[["가중_임상증상", "가중_대인관계", "가중_위기자살", "가중_부조리피해"]].mean(axis=1).round(3)

# =========================================================
# 3. 방어적 위장(Fake-Good) 탐지 알고리즘
# =========================================================
def detect_fake(row):
    # 방어적 태도(과소응답) 지수는 높으나, 표면적 위험도는 정상 범위로 낮게 표출된 경우
    if row["가중_과소응답"] >= 0.65 and row["종합_가중위험도"] <= 0.25:
        return "의심(Fake-Good)"
    return "정상"

grouped["방어적위장_탐지"] = grouped.apply(detect_fake, axis=1)

# =========================================================
# 4. 지휘관 경고 등급 판정
# =========================================================
def get_alert(row):
    if row["가중_위기자살"] >= 0.50 or row["종합_가중위험도"] >= 0.55:
        return "위험(Danger)"
    elif row["종합_가중위험도"] >= 0.38 or row["방어적위장_탐지"] == "의심(Fake-Good)":
        return "경고(Warning)"
    elif row["종합_가중위험도"] >= 0.22:
        return "주의(Caution)"
    else:
        return "관심(Normal)"

grouped["지휘관_경고등급"] = grouped.apply(get_alert, axis=1)

# =========================================================
# 5. 지휘관 맞춤형 조언 및 면담 가이드 생성
# =========================================================
def recommend_advice(row):
    alert = row["지휘관_경고등급"]
    fake = row["방어적위장_탐지"]
    
    if fake == "의심(Fake-Good)":
        return "[위장탐지] 표면상 우려가 없어 보이나 방어적 태도가 매우 높습니다. '최근 혼자 감당하기 벅찬 일이나 표현하지 못하는 부담감이 있는지' 1:1 심층 면담을 진행하십시오."
    elif alert == "위험(Danger)":
        return "[위기개입] 즉각적인 고위험 징후가 감지되었습니다. 24시간 밀착 확인 및 병영생활상담관/군병원 연계 등 선제적 보호 조치를 즉시 시행하십시오."
    elif alert == "경고(Warning)":
        return "[경고관찰] 스트레스 및 부적응 지수가 지속 상승 중입니다. 부대 내 동료 관계 및 피해 여부에 대한 구체적인 면담을 권장합니다."
    elif alert == "주의(Caution)":
        return "[기본관심] 다소 지쳐있는 상태일 수 있습니다. 부대 적응 경과를 가볍게 확인하며 격려해 주십시오."
    else:
        return "[일상관찰] 양호하게 적응 중입니다. 지속적인 긍정적 관심과 격려를 유지하십시오."

grouped["지휘관_맞춤형_조언"] = grouped.apply(recommend_advice, axis=1)

# 위험 순위 정렬 후 저장
alert_order = {"위험(Danger)": 1, "경고(Warning)": 2, "주의(Caution)": 3, "관심(Normal)": 4}
grouped["정렬순서"] = grouped["지휘관_경고등급"].map(alert_order)
grouped = grouped.sort_values(by=["정렬순서", "종합_가중위험도"], ascending=[True, False]).drop(columns=["정렬순서"])

# 결과 CSV 저장
analyzed_csv_path = "지휘관_최종_분석결과.csv"
grouped.to_csv(analyzed_csv_path, index=False, encoding="utf-8-sig")

# =========================================================
# 6. 한글 대시보드 시각화 생성
# =========================================================
fig = plt.figure(figsize=(15, 5))

# 그래프 1: 경고 등급 분포
ax1 = plt.subplot(1, 3, 1)
order = ["위험(Danger)", "경고(Warning)", "주의(Caution)", "관심(Normal)"]
sns.countplot(data=grouped, x="지휘관_경고등급", order=order, palette="Reds_r", ax=ax1)
ax1.set_title("부대원 지휘관 경고 등급 분포", fontweight='bold', fontsize=12)
ax1.set_xlabel("지휘관 경고 등급")
ax1.set_ylabel("인원 수 (명)")

# 그래프 2: 방어적 위장 탐지 산점도
ax2 = plt.subplot(1, 3, 2)
sns.scatterplot(
    data=grouped, x="종합_가중위험도", y="가중_과소응답", 
    hue="방어적위장_탐지", palette={"정상":"gray", "의심(Fake-Good)":"red"}, alpha=0.7, ax=ax2
)
ax2.axvline(0.25, color='black', linestyle='--', linewidth=1)
ax2.axhline(0.65, color='black', linestyle='--', linewidth=1)
ax2.set_title("방어적 위장(Fake-Good) 탐지 필터", fontweight='bold', fontsize=12)
ax2.set_xlabel("종합 가중 위험도 점수")
ax2.set_ylabel("과소응답 점수 (방어적 태도)")

# 그래프 3: 3개월 시계열 추이
ax3 = plt.subplot(1, 3, 3)
high_risk_id = grouped[grouped["지휘관_경고등급"] == "위험(Danger)"]["군번_ID"].iloc[0]
normal_id = grouped[grouped["지휘관_경고등급"] == "관심(Normal)"]["군번_ID"].iloc[0]

data_hr = data[data["군번_ID"] == high_risk_id]
data_norm = data[data["군번_ID"] == normal_id]

ax3.plot(data_hr["검사회차"], data_hr[["임상증상_점수", "대인관계_점수", "위기자살_점수", "부조리피해_점수"]].mean(axis=1), marker='o', color='red', label=f"위험군 ({high_risk_id})")
ax3.plot(data_norm["검사회차"], data_norm[["임상증상_점수", "대인관계_점수", "위기자살_점수", "부조리피해_점수"]].mean(axis=1), marker='o', color='blue', label=f"일반군 ({normal_id})")
ax3.set_title("3개월 시계열 위험도 추이 비교", fontweight='bold', fontsize=12)
ax3.set_xlabel("검사 회차")
ax3.set_ylabel("원천 평균 위험 점수")
ax3.legend()

plt.tight_layout()
plt.savefig("지휘관_분석_대시보드_한글.png", dpi=300, bbox_inches='tight')
plt.show()
